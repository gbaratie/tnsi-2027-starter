# Configuration du projet TNSI - Fil Rouge Dauphine 2027
# Copiez ce fichier en `.env` pour modifier la configuration (le fichier `.env` n'est jamais versionné).

# Emplacement du répertoire des données locales (créé au besoin)
FILROUGE_DATA_DIR=./data

# Fournisseur ADK : fake (défaut sans clé) | cohere | gemini | ollama
# Une valeur inconnue provoque une erreur : pas de repli silencieux vers le fake.
# FILROUGE_LLM_PROVIDER=fake

# Cohere : clé d'évaluation gratuite (1 000 appels par mois), à créer par chaque groupe
# COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025

# Gemini : clé Google AI Studio propre à chaque groupe
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Ollama : secours local (facultatif)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# RAG local (S2)
# FILROUGE_VECTOR_STORE=memory  # memory | chroma
# FILROUGE_CHROMA_DIR=./data/chroma
# FILROUGE_EMBEDDING_MODEL=embed-multilingual-v3.0

# MCP local de référence (S3)
# FILROUGE_MUSIC_LIBRARY=./tp/fixtures/music-library/library.json

# API (S4)
# FILROUGE_API_HOST=127.0.0.1
# FILROUGE_API_PORT=8000

# Neo4j Aura (S5) — ne jamais versionner les valeurs réelles
# NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
